            <mxPoint x="950" y="500" as="sourcePoint"/>
            <mxPoint x="860" y="700" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Category headings -->
        <mxCell id="cat1" value="АРХИТЕКТУРА И ПО" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="50" y="95" width="250" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cat2" value="ДАННЫЕ И БАЗЫ ДАННЫХ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="330" y="95" width="250" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cat3" value="ИНТЕГРАЦИИ И СЕТЬ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="610" y="95" width="250" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cat4" value="ИНФРАСТРУКТУРА" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="890" y="95" width="250" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="cat5" value="НАГРУЗКА И ПРОИЗВОДИТЕЛЬНОСТЬ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="120" y="720" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="cat6" value="ПЕРСОНАЛ И ПРОЦЕССЫ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="420" y="720" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="cat7" value="БЕЗОПАСНОСТЬ И НАБЛЮДАЕМОСТЬ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="720" y="720" width="300" height="50" as="geometry"/>
        </mxCell>

        <!-- Cause lists -->
        <mxCell id="cause1" value="• Неудачные границы сервисов&#xa;• Слишком много синхронных вызовов&#xa;• Длинные цепочки зависимостей&#xa;• Нет тайм-аутов и контроля повторов&#xa;• Сложность распределённых транзакций" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="150" width="270" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="cause2" value="• Файловые базы 1С и разрозненные файлы&#xa;• Дубликаты и низкое качество данных&#xa;• Конкуренция за блокировки и соединения&#xa;• Неоптимальные запросы и индексы&#xa;• Несогласованность при параллельном переносе" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="150" width="270" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="cause3" value="• Зависимость ККМ от TCP/IP и OLE&#xa;• Неизвестные контракты и направления обмена&#xa;• Сетевые задержки и потери&#xa;• Повторные запросы без идемпотентности&#xa;• Недоступность внешних участников" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="150" width="270" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="cause4" value="• Один офисный физический сервер&#xa;• Ограничение CPU, RAM и дисковых IOPS&#xa;• Общий домен отказа для нескольких служб&#xa;• Неизвестны резервирование и отказоустойчивость&#xa;• Недостаточная ёмкость целевой платформы" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="890" y="150" width="270" height="145" as="geometry"/>
        </mxCell>

        <mxCell id="cause5" value="• Нет базовых замеров и SLA/SLO&#xa;• Неизвестны пики и число одновременных пользователей&#xa;• Отчёты конкурируют с операционными транзакциями&#xa;• Не проверена производительность на целевом объёме&#xa;• Нет тестов длительной и пиковой нагрузки" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="790" width="310" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="cause6" value="• Малая IT-команда и концентрация знаний&#xa;• Не определены владельцы сервисов&#xa;• Не описаны дежурства и эскалация&#xa;• Недостаток автоматизированных тестов&#xa;• Нет проверенного плана переключения и отката" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="410" y="790" width="310" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="cause7" value="• Нет подтверждённого сквозного аудита&#xa;• Недостаточная наблюдаемость межсервисных запросов&#xa;• Не настроена корреляция событий&#xa;• Шифрование и аудит могут добавить нагрузку&#xa;• Не проверены права и контроль выгрузок" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="790" width="320" height="135" as="geometry"/>
        </mxCell>

        <mxCell id="note" value="Причины на схеме — гипотезы для проверки. В исходных данных нет замеров нагрузки, SLA, объёмов и целевой архитектуры." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="800" width="440" height="90" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>