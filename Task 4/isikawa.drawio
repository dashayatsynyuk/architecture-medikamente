          </mxGeometry>
        </mxCell>
        <mxCell id="b6" value="" style="endArrow=none;startArrow=none;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="500" as="sourcePoint"/>
