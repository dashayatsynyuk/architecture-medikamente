          </mxGeometry>
        </mxCell>
        <mxCell id="b4" value="" style="endArrow=none;startArrow=none;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1090" y="500" as="sourcePoint"/>
            <mxPoint x="1000" y="300" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Lower branches -->
        <mxCell id="b5" value="" style="endArrow=none;startArrow=none;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="500" as="sourcePoint"/>
