<mxfile host="app.diagrams.net" version="25.0.3">
  <diagram id="ishikawa-med" name="Исикава — риски производительности">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Потенциальные причины снижения производительности при миграции «Медикаменте»" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="1160" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="spine" value="" style="endArrow=none;startArrow=none;strokeWidth=4;strokeColor=#404040;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="500" as="sourcePoint"/>
            <mxPoint x="1260" y="500" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <mxCell id="effect" value="ЭФФЕКТ&#xa;Снижение производительности&#xa;и нестабильность целевой системы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#333333;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1260" y="415" width="290" height="170" as="geometry"/>
        </mxCell>

        <!-- Upper branches -->
